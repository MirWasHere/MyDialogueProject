  m_Name: 
  m_EditorClassIdentifier: 
  sentenceTexts:
  - sentence: My bed.
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: It's quite comfy, though a bit...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Transparent... at the moment...?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: 1671994790, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Don't know what that's about...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: 1671994790, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: And those frames...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: 125619286, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Haven't had the chance to put and portraits up yet...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: 125619286, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
