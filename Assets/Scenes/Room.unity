  - sentence: I should check on my garden soon.
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: An illumae flower.
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1139516402, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: A warm light naturally found in the Numinous Forest.
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: It was a gift from an old friend.
    charName: 
    drawing: {fileID: 0}
    charSprite: {fileID: -2015182570, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: Most of my clothes are in here. Along with some of my gardening tools.
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: ... I really should move those....
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -313621657, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: A lot of my storage is in the backroom.
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  dialogueUI: {fileID: 0}
