--- !u!114 &970127690
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 970127687}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f4b80f257686d24295634f4ae096f66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentenceTexts:
  - sentence: Hello dear.
    charName: ???
    drawing: {fileID: 0}
    charSprite: {fileID: -1054334577, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Hi, Mrs. Edith
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: How're you?
      nextDialogue: 2
    - responseText: Have a nice day
      nextDialogue: 15
  - sentence: How're you today?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: I'm doing quite alright, Airin.
    charName: Mrs. Edith
    drawing: {fileID: 0}
    charSprite: {fileID: -1054334577, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Though there is one thing...
    charName: Mrs. Edith
    drawing: {fileID: 0}
    charSprite: {fileID: 283249843, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Huh? What's wrong?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: My garden... a lot of my vegetables have been going missing...
    charName: Mrs. Edith
    drawing: {fileID: 0}
    charSprite: {fileID: 283249843, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: What?!
      nextDialogue: 7
    - responseText: Who would do that?
      nextDialogue: 11
  - sentence: What?! When?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: 59799245, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: It's been happening for a little while, but...
    charName: Mrs. Edith
    drawing: {fileID: 0}
    charSprite: {fileID: 283249843, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Don't worry about it,dear.
    charName: Mrs. Edith
    drawing: {fileID: 0}
    charSprite: {fileID: -1054334577, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Hmm...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: Who would do such a thing?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: 1073663244, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Oh, I don't know dear...
    charName: Mrs. Edith
    drawing: {fileID: 0}
    charSprite: {fileID: 283249843, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: But don't you worry about it.
    charName: Mrs. Edith
    drawing: {fileID: 0}
    charSprite: {fileID: -1054334577, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Hm...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: Have a nice day!
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1139516402, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: You too, dear.
    charName: Mrs. Edith
    drawing: {fileID: 0}
    charSprite: {fileID: -1054334577, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  dialogueUI: {fileID: 0}
