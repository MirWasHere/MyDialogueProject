--- !u!114 &2058901603
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2058901601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f4b80f257686d24295634f4ae096f66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentenceTexts:
  - sentence: Hey, Airin!
    charName: ???
    drawing: {fileID: 0}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: Hi, Elodie.
      nextDialogue: 3
    - responseText: See you later!
      nextDialogue: 1
  - sentence: See you later, Elodie!
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Hey we just started talking!
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: 1675714281, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: Hi, Elodie. What's up?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Guess what I found???
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: 531808673, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Umm... what've you got...?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Checkit!
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Ta-da!!
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: ...
      nextDialogue: 8
    - responseText: Huh? What is it?
      nextDialogue: 18
  - sentence: ... mhmmm...
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: 1073663244, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: ...
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: It's a map!
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: 1675714281, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: O-oh, right, of course!
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -313621657, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Where'd you find it?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: It was in the back of Grammy's yard.
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Huh... where do you think it leads?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Dunno, but I plan on following it!!
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Uh-huh, if you can find where it starts...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1139516402, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Hmph!
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: 1675714281, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: Huh? What is it?
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: It's a map, dummy!
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: 1675714281, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Oh! Y-yeah of course, but...
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -313621657, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: It's kind of hard to tell what anything is...
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: What?! No, its not!
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: 1675714281, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: That blue stuff up there is obviously water, and those spikes on the
      left are mountains!
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: 531808673, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: The line is the path and the 'X' marks the spot, DUH!
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: You need to get your eyes checked, Airin.
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: 531808673, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Ngh... ok, but...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -313621657, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Where does it lead?
      nextDialogue: 14
    - responseText: What's that thing in the corner?
      nextDialogue: 27
  - sentence: What's that thing in the corner?
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Huh?
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: You can't tell?
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: 1675714281, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Um...
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: 125619286, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Obviously!
      nextDialogue: 31
    - responseText: No...?
      nextDialogue: 38
  - sentence: Obviously! It's a, uh, pile of dirt, right...?
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -1139516402, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: WHAT?!
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: 1675714281, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: No! It's a hat! A detective hat!
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: 1675714281, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: ... it is?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: 1671994790, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Yeah, DUH! You really do need glasses.
    charName: Elodie
    drawing: {fileID: 0}
    charSprite: {fileID: 531808673, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: ...mhmm... I'll take your word for it...
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: (Honestly, I'm surprised you can see that)
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -313621657, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: Uhm... no...? It's barely gotta shape...
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: It's a hat! A detective's hat! See the brim and weird back thingy?
    charName: Elodie
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -1891603663, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: ...uh-huh...
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: (Whoever made this needs a better quil...)
    charName: Airin
    drawing: {fileID: 21300000, guid: be7ba80a7867d1740b7ef2601078a1da, type: 3}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  dialogueUI: {fileID: 507118359}
