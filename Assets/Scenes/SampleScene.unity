--- !u!114 &1921351275
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1921351273}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f4b80f257686d24295634f4ae096f66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentenceTexts:
  - sentence: '''Sup, Airin.'
    charName: ???
    drawing: {fileID: 0}
    charSprite: {fileID: 242532793, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Hey, Dallan.
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: How've you been?
      nextDialogue: 4
    - responseText: See ya!
      nextDialogue: 2
  - sentence: See ya!
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1139516402, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Bye
    charName: Dallan
    drawing: {fileID: 0}
    charSprite: {fileID: 242532793, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: How've you been?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Ah, y'know, same old, same old...
    charName: Dallan
    drawing: {fileID: 0}
    charSprite: {fileID: -473942208, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: But... I have been hearing some interesting rumors...
    charName: Dallan
    drawing: {fileID: 0}
    charSprite: {fileID: -759008921, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: Yeah?
      nextDialogue: 7
    - responseText: From who??
      nextDialogue: 17
  - sentence: Yeah? What about?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Apparently, there've been sightings of a strange looking cat wandering
      around here...
    charName: Dallan
    drawing: {fileID: 21300000, guid: 75372759f50919d47a55a0f45f9f3186, type: 3}
    charSprite: {fileID: -473942208, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: ...
    charName: Airin
    drawing: {fileID: 21300000, guid: 75372759f50919d47a55a0f45f9f3186, type: 3}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: A... cat..?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -1299832702, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: The rumor is that there cat hanging around here...??
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: -2015182570, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Ok, I know it doesn't sound like much
    charName: Dallan
    drawing: {fileID: 0}
    charSprite: {fileID: -759008921, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: But it's a really weird cat. Big, with glowing eyes, disapearing before
      anyone can get a good look.
    charName: Dallan
    drawing: {fileID: 21300000, guid: 75372759f50919d47a55a0f45f9f3186, type: 3}
    charSprite: {fileID: -473942208, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Hmm... well I'll keep an eye out.
    charName: Airin
    drawing: {fileID: 21300000, guid: 75372759f50919d47a55a0f45f9f3186, type: 3}
    charSprite: {fileID: -993253478, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Don't wanna get jumped by the big, scary ghost cat.
    charName: Airin
    drawing: {fileID: 21300000, guid: 75372759f50919d47a55a0f45f9f3186, type: 3}
    charSprite: {fileID: -1139516402, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: Yeah, yeah, whatever
    charName: Dallan
    drawing: {fileID: 0}
    charSprite: {fileID: 242532793, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: From who? There aren't that many people living here y'know?
    charName: Airin
    drawing: {fileID: 0}
    charSprite: {fileID: 1073663244, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses: []
  - sentence: ...
    charName: Dallan
    drawing: {fileID: 0}
    charSprite: {fileID: -759008921, guid: 42c8a17b17d0fda4eb8115dd9821898a, type: 3}
    responses: []
  - sentence: Sorry, right, thats not the point...
    charName: Dallan
    drawing: {fileID: 0}
    charSprite: {fileID: 1671994790, guid: 52e35a39441fedf4f952a1eade3fdc6c, type: 3}
    responses:
    - responseText: What's the rumor?
      nextDialogue: 7
  dialogueUI: {fileID: 507118359}
