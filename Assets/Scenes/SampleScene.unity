--- !u!114 &1965378996
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1965378992}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f4b80f257686d24295634f4ae096f66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentenceTexts:
  - sentence: Hey, do you need a tutorial?
    charName: Tutorial Box
    drawing: {fileID: 0}
    charSprite: {fileID: 1381732395, guid: 2f69eeff10c1ad944a38d005160f5062, type: 3}
    responses:
    - responseText: No.
      nextDialogue: 1
    - responseText: Maybe..?
      nextDialogue: 2
    - responseText: Yes!
      nextDialogue: 3
  - sentence: Alright....
    charName: Tutorial Box
    drawing: {fileID: 0}
    charSprite: {fileID: 1381732395, guid: 2f69eeff10c1ad944a38d005160f5062, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  - sentence: Ummm... that's not a definte answer...?
    charName: Tutorial Box
    drawing: {fileID: 0}
    charSprite: {fileID: 1381732395, guid: 2f69eeff10c1ad944a38d005160f5062, type: 3}
    responses:
    - responseText: No.
      nextDialogue: 1
    - responseText: Yes
      nextDialogue: 3
  - sentence: Ok, here we go!
    charName: Tutorial Box
    drawing: {fileID: 0}
    charSprite: {fileID: 1381732395, guid: 2f69eeff10c1ad944a38d005160f5062, type: 3}
    responses:
    - responseText: Exit
      nextDialogue: -1
  dialogueUI: {fileID: 507118359}
